new file mode 100644
index 00000000..5e94f4f3
--- /dev/null
+++ b/include/fast/FrameStereo.h
@@ -0,0 +1,34 @@
+#pragma once
+
+// Steam Frame 3D mode: the game is drawn as a side-by-side stereo pair and shown in the headset on a
+// floating 3D screen (two OpenXR quad layers, one per eye), instead of SteamVR's flat theater screen.
+//
+// SHIP_FRAME_3D selects it: unset or 0 is off, "sbs" draws the side-by-side picture into the window
+// (to check the stereo image on a desktop), anything else uses the headset. Tuning lives in CVars:
+//   gFrame3D.Depth        stereo strength, 1 = default
+//   gFrame3D.Focus        distance (game units) that sits on the screen; nearer things pop out
+//   gFrame3D.ScreenWidth  width of the virtual screen in metres
+//   gFrame3D.Distance     distance of the virtual screen in metres
+
+struct ImDrawData;
+struct ImVec2;
+
+namespace Fast::FrameStereo {
+
+// Whether the game should be rendered as a side-by-side pair this frame.
+bool RenderStereo();
+// Horizontal eye separation in normalised device coordinates, and the clip-space w at zero parallax.
+float Separation();
+float Convergence();
+
+// Draws the game framebuffer into the current ImGui window: the left eye, or the whole pair in "sbs".
+void DrawGameImage(void* texture, const ImVec2& size);
+
+// Shows the finished frame in the headset. Returns false when the headset isn't in use, so the caller
+// renders ImGui to the window as usual.
+bool Present(ImDrawData* drawData);
+
+// True while frames go to the headset instead of the window (the window isn't swapped then).
+bool PresentsToHeadset();
+
+} // namespace Fast::FrameStereo
