+
+// Draws the batch once per eye, the left eye in the left half of the framebuffer and the right eye in the
+// right half. Each vertex moves by half the separation times (w - convergence): things at the convergence
+// distance stay put, nearer ones come out of the screen and farther ones go into it. 2D elements (w == 1:
+// the HUD, text, rectangles) stay on the screen plane.
+void GfxRenderingAPIOGL::DrawStereo(float buf_vbo[], size_t buf_vbo_len, size_t buf_vbo_num_tris) {
+    const size_t stride = buf_vbo_len / (3 * buf_vbo_num_tris);
+    const GLint eyeWidth = (GLint)mFrameBuffers[mCurrentFrameBuffer].width;
+    mStereoVbo.assign(buf_vbo, buf_vbo + buf_vbo_len);
+    for (int eye = 0; eye < 2; eye++) {
+        const float shift = (eye == 0 ? -0.5f : 0.5f) * mStereoSeparation;
+        for (size_t i = 0; i < buf_vbo_len; i += stride) {
+            const float w = buf_vbo[i + 3];
+            mStereoVbo[i] = w == 1.0f ? buf_vbo[i] : buf_vbo[i] + shift * (w - mStereoConvergence);
+        }
+        const GLint dx = eye * eyeWidth;
+        glViewport(mViewport[0] + dx, mViewport[1], mViewport[2], mViewport[3]);
+        glScissor(mScissor[0] + dx, mScissor[1], mScissor[2], mScissor[3]);
+        glBufferData(GL_ARRAY_BUFFER, sizeof(float) * buf_vbo_len, mStereoVbo.data(), GL_STREAM_DRAW);
+        glDrawArrays(GL_TRIANGLES, 0, 3 * buf_vbo_num_tris);
+    }
+    glViewport(mViewport[0], mViewport[1], mViewport[2], mViewport[3]);
+    glScissor(mScissor[0], mScissor[1], mScissor[2], mScissor[3]);
+}
